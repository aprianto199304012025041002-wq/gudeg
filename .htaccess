Options -Indexes

# ── Protect file sensitif ─────────────────────────────────────────────────────

# Protect keys directory (RSA private/public key)
<FilesMatch "\.(pem|key)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config files
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>

# Protect dot files dan .env
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# FIX: CORS untuk verify.php dihandle dinamis di PHP (hanya izinkan origin terdaftar)
# Baris "Header set Access-Control-Allow-Origin *" DIHAPUS

# ── PHP settings ──────────────────────────────────────────────────────────────

# Session security
php_value session.cookie_httponly 1
php_value session.use_strict_mode 1
php_value session.cookie_samesite Lax

# FIX: Matikan display error — jangan tampilkan error PHP ke browser
php_flag display_errors Off
php_flag log_errors On

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── OpenID Connect discovery ───────────────────────────────────────────────────

# /.well-known/openid-configuration adalah file JSON statis biasa (tanpa
# ekstensi), jadi kita paksa Content-Type-nya supaya klien OIDC/HTTP library
# mengenalinya sebagai JSON, bukan text/plain atau octet-stream.
<Files "openid-configuration">
    ForceType application/json
</Files>

# jwks.json sebenarnya adalah skrip PHP (perlu baca keys/public.pem secara
# dinamis), tapi supaya URL publiknya tetap /jwks.json sesuai standar JWKS,
# kita paksa Apache mengeksekusinya lewat PHP handler meski ekstensinya .json.
<Files "jwks.json">
    ForceType application/x-httpd-php
</Files>

# ── Error pages ───────────────────────────────────────────────────────────────
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
