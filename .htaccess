Options -Indexes

# ── Protect file sensitif ─────────────────────────────────────────────────────

# Protect keys directory (RSA private/public key)
<FilesMatch "\.(pem|key)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config files
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>

# Protect dot files dan .env
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# FIX: CORS untuk verify.php dihandle dinamis di PHP (hanya izinkan origin terdaftar)
# Baris "Header set Access-Control-Allow-Origin *" DIHAPUS

# ── PHP settings ──────────────────────────────────────────────────────────────

# Session security
php_value session.cookie_httponly 1
php_value session.use_strict_mode 1
php_value session.cookie_samesite Lax
php_value session.cookie_secure 1

# FIX: Matikan display error — jangan tampilkan error PHP ke browser
php_flag display_errors Off
php_flag log_errors On

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Cegah MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Cegah clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS Protection (legacy browser)
    Header set X-XSS-Protection "1; mode=block"

    # Batasi info referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS — paksa HTTPS selama 1 tahun (termasuk subdomain)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'self'; form-action 'self'; base-uri 'self'"

    # Permissions Policy — nonaktifkan fitur browser yang tidak dipakai
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"

    # Hapus header yang bocorkan info server
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ── OpenID Connect discovery ───────────────────────────────────────────────────
<Files "openid-configuration">
    ForceType application/json
</Files>

# jwks.json dieksekusi sebagai PHP
<Files "jwks.json">
    ForceType application/x-httpd-php
</Files>

# ── Error pages ───────────────────────────────────────────────────────────────
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
