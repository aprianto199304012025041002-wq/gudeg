Options -Indexes

# ── Protect file sensitif ─────────────────────────────────────────────────────

# Protect keys directory (RSA private/public key)
<FilesMatch "\.(pem|key)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config files
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>

# Protect dot files dan .env
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# FIX: CORS untuk verify.php dihandle dinamis di PHP (hanya izinkan origin terdaftar)
# Baris "Header set Access-Control-Allow-Origin *" DIHAPUS

# ── PHP settings ──────────────────────────────────────────────────────────────

# Session security
php_value session.cookie_httponly 1
php_value session.use_strict_mode 1
php_value session.cookie_samesite Lax
php_value session.cookie_secure 1

# FIX: Matikan display error — jangan tampilkan error PHP ke browser
php_flag display_errors Off
php_flag log_errors On

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Cegah MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Cegah clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS Protection (legacy browser)
    Header always set X-XSS-Protection "1; mode=block"

    # Batasi info referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS — paksa HTTPS selama 1 tahun (termasuk subdomain)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # CSP dinonaktifkan sementara — konflik dengan Kaspersky EPR SSL inspection
    # Aktifkan kembali setelah gudeg.xo.je di-whitelist di Kaspersky Security Center

    # Permissions Policy — nonaktifkan fitur browser yang tidak dipakai
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"

    # Hapus header yang bocorkan info server
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── OpenID Connect discovery ───────────────────────────────────────────────────
<Files "openid-configuration">
    ForceType application/json
</Files>

# jwks.json dieksekusi sebagai PHP
<Files "jwks.json">
    ForceType application/x-httpd-php
</Files>

# ── Error pages ───────────────────────────────────────────────────────────────
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
